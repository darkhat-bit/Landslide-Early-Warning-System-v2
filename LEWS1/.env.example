# LEWS (Landslide Early Warning System) Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Application Environment
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Geocoding Service (OpenStreetMap Nominatim)
# Usage Policy: Requires a distinct, identifying User-Agent and max 1 request/second.
NOMINATIM_USER_AGENT=LEWS-Disaster-Warning-System/2.0 (contact: emergency-research@lews.local)

# Routing Services
# Default: Uses public OSRM demo server (http://router.project-osrm.org) - No API key required for demo/academic testing.
# Optional Provider: OpenRouteService (requires free API key from https://openrouteservice.org)
OPENROUTESERVICE_API_KEY=

# Emergency Email Alerts (Phase 5)
# Set EMAIL_ALERTS_ENABLED=true and provide SMTP credentials to send real emails via TLS.
# When EMAIL_ALERTS_ENABLED=false or credentials are empty, alerts are safely simulated and logged locally to:
# data/processed/alerts/simulated_email_log.jsonl
EMAIL_ALERTS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=lews-alerts@sikkim.gov.in
